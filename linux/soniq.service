[Unit]
Description=SONIQ Music Generator
Documentation=https://github.com/petergerov/soniq
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soniq
Group=soniq
WorkingDirectory=/opt/soniq/app
EnvironmentFile=-/etc/soniq/soniq.env
Environment=MG_PACKAGED=1
Environment=MG_DATA_DIR=/var/lib/soniq/data
Environment=MG_MODELS_DIR=/var/lib/soniq/models
Environment=MG_ENGINE_BIN=/opt/soniq/bin/ace-server
Environment=LD_LIBRARY_PATH=/opt/soniq/lib
ExecStart=/opt/soniq/bin/node --disable-warning=ExperimentalWarning /opt/soniq/app/backend/src/main.ts
Restart=on-failure
RestartSec=3
# Modelle und Songs können groß sein
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
